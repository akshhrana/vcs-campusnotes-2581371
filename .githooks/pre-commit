#!/bin/sh
# Pre-commit hook: reject a commit if a staged file contains a
# marker word for unfinished work. The pattern is split so this
# script does not match itself when it is staged.
if git diff --cached --name-only -z | xargs -0 grep -l -E 'TOD[O]|FIXM[E]' 2>/dev/null | grep -q .; then
  mark1='TOD'"O"
  mark2='FIXM'"E"
  echo "pre-commit: blocked - a staged file contains $mark1 or $mark2."
  echo "Remove the marker before committing."
  git diff --cached --name-only -z | xargs -0 grep -l -E 'TOD[O]|FIXM[E]' 2>/dev/null
  exit 1
fi
exit 0
